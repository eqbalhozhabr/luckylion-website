{
  "name": "nasty-neptune",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run sync-worker-engine && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync-worker-engine": "node scripts/sync-worker-engine.mjs",
    "worker:dev": "npm run sync-worker-engine && npm run build && wrangler dev",
    "worker:migrate:local": "wrangler d1 migrations apply pixels-of-the-mist --local",
    "worker:migrate:remote": "wrangler d1 migrations apply pixels-of-the-mist --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.0",
    "gsap": "^3.15.0",
    "marked": "^18.0.10"
  },
  "devDependencies": {
    "wrangler": "^4.136.3"
  }
}

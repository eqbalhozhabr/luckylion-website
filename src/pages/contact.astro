---
import Layout from '../layouts/Layout.astro';

// آبجکت‌های متحرکِ صفحه‌ی هیرو (index.astro) — عکس/اندازه/چرخش از اونجا کپی
// شده. جانمایی (x/y) طبق دایره‌های قرمزی که رو اسکرین‌شات کشیدی تنظیم شده؛
// یه حدسِ اول‌به‌آخره، اگه جایی دقیق نبود بگو تا میلی‌متری اصلاحش کنم.
// نکته: «Meeple Blue» و «Meeple» هر دو از یه فایل (Meeple_01.webp) میان — عکسِ
// جدای «آبی» نداریم، پس این دوتا دقیقاً یه شکل رو نشون می‌دن.
const components = [
  { name: 'Large Monster', src: '/hero/Monster_L.webp', x: 18, y: 13, w: 11.5625, h: 13.8889, transform: 'none' },
  { name: 'Medium Monster', src: '/hero/Monster_M.webp', x: 80, y: 55, w: 8.8021, h: 12.4074, transform: 'matrix(.848, .53, -.53, .848, 0, 0)' },
  { name: 'Small Monster', src: '/hero/Monster_S.webp', x: 21, y: 72, w: 8.125, h: 10.2778, transform: 'none' },
  // این دو تا مهره فقط اینجا (نه توی صفحه‌ی هیرو) ۲۰٪ بزرگ‌تر از اصلشون‌ان و
  // چرخششون هم عمداً باهم فرق داره، وگرنه چون دقیقاً یه عکسِ یکسانن، کنارِ هم
  // مثلِ یه کپی/آینه به‌نظر می‌رسیدن.
  { name: 'Meeple', src: '/hero/Meeple_01.webp', x: 8, y: 86, w: 4.5625, h: 7.8889, transform: 'rotate(-18deg)' },
  { name: 'Wood Token', src: '/hero/TokenWood.webp', x: 85, y: 75, w: 4.1667, h: 7.3148, transform: 'none' },
  { name: 'Food Token', src: '/hero/TokenFood.webp', x: 89, y: 74, w: 4.0625, h: 7.3148, transform: 'matrix(.616, -.788, .788, .616, 0, 0)' },
  { name: 'Meeple Blue', src: '/hero/Meeple_01.webp', x: 81, y: 86, w: 4.56, h: 7.8, transform: 'rotate(32deg)' },
];
---

<Layout>
<section class="hero" data-contact-section aria-label="Contact The Last Shelter">

  <div class="artboard">
    <div class="table-plane" aria-hidden="true">
      <div class="table-plane-inner">

        <!-- ویدیوی تعاملی بک‌گراند که شامل میز، شیت کاراکتر و انیمیشن تایل پناهگاه است.
             src عمداً اینجا نیست — توی اسکریپت با fetch+blob پر می‌شه، نه مستقیم.
             دلیلش: روی سرورِ لوکال (Vite) درخواستِ Range درست جواب داده می‌شه، پس
             ویدیو قابلِ seek‌ه؛ ولی Cloudflare Pages برای فایل‌های استاتیک هدرِ
             Accept-Ranges/۲۰۶ رو برنمی‌گردونه (تست شد — حتی برای یه عکسِ ساده هم
             همینه)، پس مرورگر با اینکه کلِ فایل رو دانلود می‌کنه، ویدیو رو
             seekable=[0,0] می‌بینه و کلیک هیچ فریمی رو عوض نمی‌کنه. با گرفتنِ
             کلِ فایل به‌صورتِ blob و دادنش به‌عنوانِ src، دیگه seek کاملاً
             لوکاله و به Range-support سرور وابسته نیست. -->
        <video
          id="interactive-bg"
          class="table-background"
          muted
          playsinline
          preload="auto"
        ></video>

        <!-- منطقه کلیکِ روی شیت کاراکتر — فقط تزئینیه (چیزی رو باز/جایگزین نمی‌کنه)
             برای همین با tabindex="-1" از چرخه‌ی Tab کیبورد بیرونش گذاشتیم؛ وگرنه
             هر بار کاربر Tab می‌زد یه کادرِ فوکوسِ سفید دورش ظاهر می‌شد. با موس/لمس
             هنوز کاملاً قابل‌کلیکه. -->
        <button
          type="button"
          class="click-trigger"
          data-click-trigger
          tabindex="-1"
          aria-hidden="true"
        ></button>

        <div class="table-components">
          {components.map((component) => (
            <div
              class="component-placement"
              style={`--x:${component.x}%; --y:${component.y}%; --w:${component.w}%; --h:${component.h}%; --placement:${component.transform};`}
            >
              <img class="table-component" src={component.src} alt={component.name} draggable="false" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- لایه ثابت UI شامل متن‌های صفحه تماس -->
  <div class="contact-ui" aria-label="Contact Information">
    <div class="contact-text-box">
      <h1>Contact Us</h1>
      <p>Your feedback is our priority. Whether you have questions about the mechanics, rules, or just want to share your survival stories, we are always here to listen.</p>
      <div class="contact-email-block">
        <span class="contact-email">info@luckylion.games</span>
        <div class="contact-actions">
          <button type="button" data-copy-email>Copy email</button>
          <a href="mailto:info@luckylion.games">Open email app</a>
        </div>
      </div>
    </div>
  </div>

  <!-- لوگوی استودیو و دکمه منو دیگه اینجا نیست — از Layout میان (SiteChrome.astro)
       تا دقیقاً همون چیزی باشه که توی صفحه‌ی اصلی هم هست، بدون تکرار و بدون
       ریسکِ دوباره‌ایجاد‌شدنِ باگِ ناپدید‌شدن. -->

</section>
</Layout>

<style>
  :global(html), :global(body) { overflow-x: hidden; margin: 0; }
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #121817; height: 100dvh; }

  .artboard {
    position: absolute; inset: 50% auto auto 50%;
    width: max(100%, calc(100dvh * 16 / 9));
    height: max(100%, calc(100dvw * 9 / 16));
    aspect-ratio: 16 / 9; transform: translate(-50%, -50%);
  }
  .table-plane { position: absolute; inset: 0; z-index: 1; overflow: hidden; }
  .table-plane-inner { position: absolute; inset: 0; transform: scale(1.065); will-change: transform; }

  .table-background { display: block; width: 100%; height: 100%; object-fit: cover; }
  .table-components { position: absolute; inset: 0; pointer-events: none; }

  /* تنظیمات ناحیه کلیک نامرئی روی شیت کاراکتر */
  .click-trigger {
    position: absolute;
    /* این درصدها را بعد از آماده شدن ویدیو تغییر بده تا دقیقاً روی شیت کاراکتر قرار بگیرد */
    left: 35%; top: 20%; width: 30%; height: 60%;
    cursor: pointer;
    z-index: 10;
    /* بی‌استایل کردنِ ظاهرِ پیش‌فرضِ دکمه، چون فقط یه ناحیه‌ی نامرئیِ کلیک‌پذیره */
    background: none; border: 0; padding: 0; -webkit-tap-highlight-color: transparent;
  }

  .component-placement {
    position: absolute; left: var(--x); top: var(--y); width: var(--w); height: var(--h);
    transform: var(--placement); transform-origin: 0 0; pointer-events: auto;
  }
  .table-component {
    display: block; width: 100%; height: 100%; object-fit: contain; cursor: pointer; user-select: none; will-change: transform;
    filter: drop-shadow(0 -5px 2px rgb(0 0 0 / .5)) drop-shadow(0 15px 150px rgb(0 0 0 / .1));
  }

  /* استایل‌های متن Contact Us */
  .contact-ui {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; color: #d8dfe5;
    display: flex; align-items: center; justify-content: flex-start;
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }
  .contact-text-box {
    width: min(35vw, 30rem);
    text-align: left;
    text-shadow: 0 5px 8px #000, 0 0 20px rgb(0 0 0 / .7);
  }
  .contact-text-box h1 {
    font-family: var(--font-title); font-size: clamp(2rem, 4vw, 3.5rem); margin: 0 0 0.5rem 0; color: #fff;
  }
  .contact-text-box p {
    font-family: var(--font-body); font-size: clamp(0.9rem, 1.2vw, 1.25rem); line-height: 1.5; margin: 0;
  }

  /* ایمیل + دکمه‌های کپی/باز کردن — همون چیزی که قبلاً توی منو بود، حالا اینجا */
  .contact-email-block {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    display: flex; flex-direction: column; align-items: flex-start; gap: .6rem;
    pointer-events: auto;
  }
  .contact-email {
    font-size: clamp(.95rem, 1.4vw, 1.15rem); color: rgb(255 255 255 / .9); letter-spacing: .02em; user-select: all;
  }
  .contact-actions { display: flex; gap: .75rem; }
  .contact-actions button, .contact-actions a {
    font-size: .8rem; color: #d8dfe5; text-decoration: none;
    border: 1px solid rgb(255 255 255 / .35); border-radius: 999px; padding: .4rem .9rem;
    background: rgb(18 24 23 / .35); backdrop-filter: blur(6px); cursor: pointer;
    transition: border-color .2s ease, color .2s ease;
  }
  .contact-actions button:hover, .contact-actions a:hover { border-color: #fff; color: #fff; }

  @media (max-width: 640px), (max-aspect-ratio: 3 / 4) {
    .contact-ui { align-items: center; justify-content: center; text-align: center; }
    .contact-text-box { width: 90vw; text-align: center; }
    .contact-email-block { align-items: center; }
  }

  @media (prefers-reduced-motion: reduce) { .table-plane-inner, .table-component { transition: none !important; } }
</style>

<script>
  import { gsap } from 'gsap';

  const section = document.querySelector<HTMLElement>('[data-contact-section]');
  const motionAllowed = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && motionAllowed) {
    const plane = section.querySelector<HTMLElement>('.table-plane-inner')!;
    const planeMoveX = gsap.quickTo(plane, 'x', { duration: .65, ease: 'power3.out' });

    // مثلِ صفحه‌ی اصلی، حرکتِ بک‌گراند فقط در جهتِ X هست، نه X و Y با هم.
    section.addEventListener('pointermove', (event) => {
      const x = event.clientX - innerWidth / 2;
      planeMoveX(-x * .015);
    });

    // هاورِ نرم و فیزیکی کامپوننت‌های پراکنده
    section.querySelectorAll<HTMLElement>('.table-component').forEach((component) => {
      const glideX = gsap.quickTo(component, 'x', { duration: .5, ease: 'power2.out' });
      const glideY = gsap.quickTo(component, 'y', { duration: .5, ease: 'power2.out' });
      const turn = gsap.quickTo(component, 'rotation', { duration: .75, ease: 'power2.out' });

      component.addEventListener('pointermove', (event) => {
        const bounds = component.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - .5;
        const y = (event.clientY - bounds.top) / bounds.height - .5;
        glideX(x * 75); glideY(y * 75); turn(x * 25);
      });
    });
  }

  // ----------------------------------------------------
  // منطق ویدیوی تعاملی (Video State Machine)
  // این بخش از motionAllowed مستقل نگه داشته شده: اگه ویدیو واقعاً محتوا
  // (نه فقط دکوراسیون) رو نشون می‌ده، کاربرِ prefers-reduced-motion هم باید
  // بتونه بین مراحل جابه‌جا بشه — فقط با یه جهش‌ِ آنی به‌جای پخشِ روون.
  // ----------------------------------------------------
  // دکمه‌ی «Copy email» — کپی کردن آدرس ایمیل به کلیپ‌بورد
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  copyEmailButton?.addEventListener('click', async () => {
    const email = document.querySelector('.contact-email')?.textContent?.trim() ?? '';
    const originalLabel = copyEmailButton.textContent;
    try {
      await navigator.clipboard.writeText(email);
      copyEmailButton.textContent = 'Copied!';
    } catch {
      copyEmailButton.textContent = 'Copy failed';
    }
    setTimeout(() => { copyEmailButton.textContent = originalLabel; }, 1800);
  });

  const video = document.getElementById('interactive-bg') as HTMLVideoElement;
  const trigger = document.querySelector<HTMLButtonElement>('[data-click-trigger]');

  // ۶۰ فریمِ رندرشده @ 24fps → کلِ ویدیو ۲.۵ ثانیه‌ست. نقاطِ توقف طبق فریم‌های
  // خودت (۰، ۲۰، ۴۰، ۶۰) به ثانیه تبدیل شدن، نه هاردکد — اگه framerate یا
  // فریم‌های توقف عوض شد، فقط همین دو عدد رو عوض کن.
  const FPS = 24;
  const stopTimes = [0, 20, 40, 60].map((frame) => frame / FPS);
  let currentStep = 0;
  let isAnimating = false; // جلوگیری از کلیک رگباری تا وقتی حرکتِ قبلی تمام نشده
  let activeIntervalId: ReturnType<typeof setInterval> | null = null;

  if (video && trigger) {
    // موبایل (بخصوص iOS/iPadOS Safari، و بعضاً Chrome اندروید) تا وقتی ویدیو
    // حداقل یه بار واقعاً play نشده هیچ فریمی رو رندر/نقاشی نمی‌کنه — even با
    // src ست‌شده و preload="auto" و currentTime دستی. قبلاً اینجا فقط src ست
    // می‌شد و بعدش هیچ‌وقت play() صدا زده نمی‌شد (فقط currentTime عوض می‌شد)،
    // پس روی موبایل صفحه خالی می‌موند تا اولین لمسِ کاربر (یه user gesture)
    // بالاخره مرورگر رو مجبور به رندر می‌کرد. چون ویدیو muted+playsinline‌ه،
    // play() بدونِ نیاز به تعاملِ کاربر مجازه — بلافاصله pause می‌کنیم تا فقط
    // فریمِ ۰ «گرم» و نقاشی‌شده بمونه، بدونِ اینکه واقعاً پخش دیده بشه.
    function warmUpFirstFrame() {
      // به رویدادِ 'playing' گوش می‌دیم (نه به Promise ای که play() برمی‌گردونه)
      // چون این رویداد دقیقاً همون لحظه‌ای صدا زده می‌شه که مرورگر واقعاً اولین
      // فریم رو رندر کرده — اگه به‌جاش منتظرِ resolve شدنِ Promise می‌موندیم،
      // اگه ترد اصلی (مثلاً وسطِ لود شدنِ بقیه‌ی صفحه) مشغول بود، ممکن بود
      // پخش قبل از رسیدنِ ما به pause() چند فریم (یا حتی کلِ ۲.۵ ثانیه) جلو
      // بره — یعنی یه فلشِ کوتاهِ ناخواسته از انیمیشن، دقیقاً قبل از اینکه
      // pause بشه.
      video.addEventListener('playing', () => {
        video.pause();
        video.currentTime = 0;
      }, { once: true });
      video.play().catch(() => {
        // بعضی وب‌ویوهای محدودِ داخلِ اپ ممکنه حتی اینجا هم رد کنن؛ در اون
        // حالت همون رفتارِ قبلی (رندر بعد از اولین لمس) باقی می‌مونه، فقط
        // این fallback باعثِ خطا نمی‌شه.
      });
    }

    // کلِ فایلِ ویدیو رو می‌گیریم و به‌عنوانِ blob URL می‌دیم به src — به همون
    // دلیلی که بالای تگِ <video> توضیح داده شد (Cloudflare Pages درخواستِ
    // Range رو درست جواب نمی‌ده، پس seek روی src مستقیم کار نمی‌کنه). تا این
    // fetch تموم نشه، دکمه غیرفعاله (کلیکش هیچ کاری نمی‌کنه).
    fetch('/contact/contact-animation.webm')
      .then((res) => res.blob())
      .then((blob) => {
        video.src = URL.createObjectURL(blob);
        warmUpFirstFrame();
      })
      .catch(() => {
        // اگه fetch شکست خورد، حداقل src مستقیم رو امتحان کن — بدونِ seek ولی
        // بهتر از یه ویدیوی کاملاً خالی.
        video.src = '/contact/contact-animation.webm';
        warmUpFirstFrame();
      });

    // مرحله‌های رفتِ جلو (۱ تا ۳): دیگه اصلاً از video.play() استفاده نمی‌کنیم؛
    // خودمون هر ۱/۲۴ ثانیه currentTime رو دستی، با سرعتِ طبیعیِ ۲۴fps، جلو
    // می‌بریم — پس هیچ‌وقت از هدف رد نمی‌شه. این مرحله‌ها کوتاه‌ان (حداکثر
    // ۰.۸۳ ثانیه)، پس با سرعتِ طبیعی هم مشکلی ندارن.
    function animateForwardTo(targetTime: number) {
      isAnimating = true;
      const startTime = video.currentTime;
      const distance = targetTime - startTime;
      const duration = Math.abs(distance);
      const startTs = performance.now();

      if (activeIntervalId !== null) clearInterval(activeIntervalId);
      activeIntervalId = setInterval(() => {
        const elapsed = (performance.now() - startTs) / 1000;
        const progress = Math.min(elapsed / duration, 1);

        if (progress >= 1) {
          video.currentTime = targetTime; // قفل کردن دقیق روی فریمِ هدف
          isAnimating = false;
          if (activeIntervalId !== null) clearInterval(activeIntervalId);
          activeIntervalId = null;
          return;
        }
        video.currentTime = startTime + distance * progress;
      }, 1000 / FPS);
    }

    trigger.addEventListener('click', () => {
      // کلیکِ موس، صرف‌نظر از tabindex="-1"، خودش فوکوس رو روی دکمه نگه می‌داره؛
      // چون این دکمه توی یه لایه‌ی aria-hidden="true" هست (.table-plane)،
      // مرورگر یه اخطار می‌ده («Blocked aria-hidden on an element because its
      // descendant retained focus»). چون این دکمه اصلاً قرار نیست فوکوس بمونه،
      // بلافاصله بعدِ کلیک blur می‌کنیمش.
      trigger.blur();

      if (isAnimating) return; // جلوگیری از کلیک رگباری کاربر تا زمانی که انیمیشن قبلی تمام نشده

      currentStep = (currentStep + 1) % stopTimes.length;
      const targetTime = stopTimes[currentStep];

      // برگشت به شروع (فریم ۶۰ ← ۰) یه جهشِ آنیه، بدونِ انیمیشن — بعد از ۳ تلاشِ
      // ناموفق برای نشون‌دادنِ این مرحله با حرکت (پخشِ کامل، جهشِ سریع، فلشِ
      // نور — هر سه یا حسِ عجیب می‌دادن یا صفحه رو سیاه می‌کردن)، برگشتیم به
      // همینِ ساده: بدونِ حرکت، بدونِ فلش. تنها اثرش اینه که کلیکِ بعدی از این
      // مرحله، تازه اولین حرکتِ قابل‌دیدن رو نشون می‌ده.
      if (!motionAllowed || currentStep === 0) {
        video.currentTime = targetTime;
        return;
      }

      animateForwardTo(targetTime);
    });
  }
</script>
---
import Layout from '../layouts/Layout.astro';

interface Props {
  /** Optional transparent WebM (with alpha) used as the mist overlay. */
  mistVideoSrc?: string;
}

const { mistVideoSrc } = Astro.props;

// Exact placements converted from the 1920 × 1080 SVG artboard.
const components = [
  { name: 'Pickup Blue 02', src: '/hero/Pickup_Blue_02.webp', x: 75.6097, y: 53.2775, w: 9.4792, h: 25, transform: 'matrix(.799, .602, -.602, .799, 0, 0)' },
  { name: 'Pickup Blue 01', src: '/hero/Pickup_Blue_01.webp', x: 81.786, y: 97.4119, w: 9.4792, h: 25, transform: 'matrix(.883, -.469, .469, .883, 0, 0)' },
  { name: 'Trap Tile 01', src: '/hero/TrapTiles_01_RGB copy.webp', x: 31.6773, y: 86.3437, w: 6.8229, h: 12.1296, transform: 'matrix(.995, .105, -.105, .995, 0, 0)' },
  { name: 'Trap Tile 02', src: '/hero/TrapTiles_02_RGB.webp', x: 9.0528, y: 64.2195, w: 6.8229, h: 12.1296, transform: 'rotate(-12deg)' },
  { name: 'Trap Tile 04', src: '/hero/TrapTiles_04_RGB.webp', x: 37.7632, y: 47.8198, w: 6.8229, h: 12.1296, transform: 'rotate(9deg)' },
  { name: 'Meeple', src: '/hero/Meeple_01.webp', x: 29.1667, y: 61.0185, w: 3.8021, h: 6.5741, transform: 'none' },
  { name: 'Large Monster', src: '/hero/Monster_L.webp', x: -4.6354, y: 53.7037, w: 11.5625, h: 13.8889, transform: 'none' },
  { name: 'Medium Monster', src: '/hero/Monster_M.webp', x: 5.6951, y: 3.1855, w: 8.8021, h: 12.4074, transform: 'matrix(.848, .53, -.53, .848, 0, 0)' },
  { name: 'Small Monster', src: '/hero/Monster_S.webp', x: 59.375, y: 53.7037, w: 8.125, h: 10.2778, transform: 'none' },
  { name: 'Pickup Red', src: '/hero/Pickup_Red.webp', x: 21.9501, y: 4.8244, w: 10.5208, h: 10, transform: 'rotate(-13deg)' },
  { name: 'Shelter Tile', src: '/hero/Shelter_Tile.webp', x: 62.5, y: 85.6481, w: 17.3958, h: 28.0556, transform: 'none' },
  { name: 'Food Token', src: '/hero/TokenFood.webp', x: 14.7253, y: 55.6912, w: 4.0625, h: 7.3148, transform: 'matrix(.616, -.788, .788, .616, 0, 0)' },
  { name: 'Oil Token', src: '/hero/TokenOil.webp', x: 19.8664, y: 57.0926, w: 4.0625, h: 7.3148, transform: 'rotate(-21deg)' },
  { name: 'Sacrifice Token', src: '/hero/TokenSacr.webp', x: 21.9271, y: 47.3148, w: 4.1667, h: 7.4074, transform: 'none' },
  { name: 'Wood Token', src: '/hero/TokenWood.webp', x: 5.5208, y: 44.1667, w: 4.1667, h: 7.3148, transform: 'none' },
];
---

<Layout>
<!-- Hero and Scene 2 are stacked exactly on top of each other inside this
     stage (both position:absolute, filling it) and the whole stage gets
     pinned by ScrollTrigger — so scrolling doesn't move Scene 2 "up from
     below"; it stays put in place while hero fades out and Scene 2 fades
     in on top of it, in the same spot. See the script at the bottom. -->
<div class="pin-stage" data-pin-stage>
<section class="hero" id="hero" data-hero aria-label="The Last Shelter">
  <!-- The artboard is "cover"-sized so the decorative table background and
       components always fill the screen edge-to-edge (their edges may crop,
       which is fine — purely decorative, not real UI). -->
  <div class="artboard">
    <div class="table-plane" aria-hidden="true">
      <div class="table-plane-inner">
        <img class="table-background" src="/hero/bg-table.webp" alt="" />
        <div class="table-components">
          {components.map((component) => (
            <div
              class="component-placement"
              style={`--x:${component.x}%; --y:${component.y}%; --w:${component.w}%; --h:${component.h}%; --placement:${component.transform};`}
            >
              <img class="table-component" src={component.src} alt={component.name} draggable="false" />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Supply an alpha-enabled WebM through mistVideoSrc when the mist asset is ready. -->
    <div class="mist-video-wrapper" aria-hidden="true">
      {mistVideoSrc && <video class="mist-video" autoplay muted loop playsinline src={mistVideoSrc}></video>}
    </div>
  </div>

  <!-- hero-ui is a direct child of .hero (the real, never-cropped viewport
       box), NOT of .artboard — so the logo/text/menu can never end up
       off-screen or hidden behind browser chrome, regardless of window
       aspect ratio. Positions/sizes use clamp() with vw/vh so they scale
       and reflow continuously with the window width instead of jumping at
       a single breakpoint. -->
  <div class="hero-ui" aria-label="The Last Shelter game information">
    <img class="game-logo" src="/hero/LogoTheLastShelter.webp" alt="The Last Shelter: Whispers of the Mist" />
    <p class="game-copy">When a mysterious fog engulfed the Mazandaran coast, lurking monsters emerged to prey on the living. You must gather resources, build the Last Shelter, and use fire to survive.</p>
  </div>


</section>

<!-- SCENE 2: floating box. Two frame sequences drawn on a <canvas> instead
     of playing a <video>, so scroll position and mouse position can control
     the exact frame with no lag/buffering — see the script below. -->
<section class="scene2" id="scene2" data-scene2 aria-label="The Last Shelter overview">
  <!-- Same cover-sizing formula as .artboard in the hero, so the box's
       scale/position exactly matches where it "was" in the hero — this is
       what makes the crossfade feel like the same object, not a resize. -->
  <div class="scene2-artboard">
    <canvas class="scene2-canvas" data-scene2-canvas></canvas>
  </div>
  <div class="scene2-info" data-scene2-info>
    <div class="icon-orbit"><img class="info-icon" data-icon src="/scene2/icons/players.webp" alt="1-5 Players" /></div>
    <div class="icon-orbit"><img class="info-icon" data-icon src="/scene2/icons/time.webp" alt="90 Minutes" /></div>
    <div class="icon-orbit"><img class="info-icon" data-icon src="/scene2/icons/age.webp" alt="Ages 14+" /></div>
  </div>
</section>
<!-- Thematic fog wash that swells during the hero->Scene 2 crossfade and
     clears once Scene 2 is fully in — ties into the game's mist theme,
     and conveniently helps mask the crossfade seam between the hero photo
     and the rendered box. Pure CSS gradients, no asset needed. -->
<div class="transition-mist" data-transition-mist aria-hidden="true">
  <div class="transition-mist__layer transition-mist__layer--a"></div>
  <div class="transition-mist__layer transition-mist__layer--b"></div>
</div>
</div>

<!-- Studio logo + menu button + nav used to be duplicated here, but that's
     now what SiteChrome.astro (rendered once from Layout.astro) is for —
     see that file's header comment for why living there instead of here
     fixes the same z-index/stacking problem this old comment used to
     describe. Keeping a second copy here made `[data-menu-toggle]` /
     `[data-site-menu]` ambiguous: the page's own click listener bound to
     whichever copy `document.querySelector` found first, while the OTHER
     copy (SiteChrome's, painted on top since it renders later in the DOM)
     was the one actually visible and clickable — so the menu button
     silently did nothing. Don't re-add this markup here; add it to
     SiteChrome.astro instead so every page stays in sync automatically. -->
</Layout>

<style>
  /* Safety net: nothing should overflow the viewport anymore (see .artboard
     below), but keep this so no other element on the page can reopen a
     side-scrollbar either. Also reset the browser's default 8px body margin,
     which was adding to the page's scrollable height. */
  :global(html), :global(body) {
    overflow-x: hidden;
    margin: 0;
  }

  /* Everything the section needs, defined here directly instead of via
     Tailwind classes — those weren't being applied in this project (that's
     why height and background were both failing earlier). */
  .pin-stage {
    position: relative;
    height: 100dvh;
    overflow: hidden; /* clips oversized children like .transition-mist (-15% inset) so they can't add scrollable page height */
  }
  .hero {
    position: absolute; inset: 0;
    isolation: isolate;
    overflow: hidden;
    background: #121817;
  }

  .artboard {
    position: absolute; inset: 50% auto auto 50%;
    /* max() = "cover": background + tabletop components always fill the
       screen edge-to-edge (their edges may crop, which is fine — purely
       decorative). The UI layer (logo/text/menu) is NOT inside this box
       anymore — see .hero-ui below — so it can never be cropped with it. */
    width: max(100%, calc(100dvh * 16 / 9));
    height: max(100%, calc(100dvw * 9 / 16));
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%);
  }
  .table-plane, .mist-video-wrapper { position: absolute; inset: 0; }
  .table-plane { z-index: 1; overflow: hidden; }
  .mist-video-wrapper { will-change: transform; }
  /* The actual parallax scale/translate lives on this inner wrapper instead. */
  .table-plane-inner { position: absolute; inset: 0; transform: scale(1.065); will-change: transform; }
  .table-background { display: block; width: 100%; height: 100%; object-fit: fill; }
  .table-components { position: absolute; inset: 0; }

  .component-placement {
    position: absolute; left: var(--x); top: var(--y); width: var(--w); height: var(--h);
    transform: var(--placement); transform-origin: 0 0;
  }
  .table-component {
    display: block; width: 100%; height: 100%; object-fit: contain;
    cursor: pointer; user-select: none; will-change: transform;
    filter: drop-shadow(0 -5px 2px rgb(0 0 0 / .5)) drop-shadow(0 15px 150px rgb(0 0 0 / .1));
  }

  .mist-video-wrapper { z-index: 2; pointer-events: none; overflow: hidden; }
  .mist-video { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* hero-ui sits directly on .hero (the real viewport box), not on
     .artboard — so its own inset never depends on the cover-cropped
     background. A fluid clamp()-based edge gap keeps everything a safe
     distance from the real screen edges at any window size.

     To move things further from/closer to the edges, change the numbers
     inside clamp(min, preferred, max) below — e.g. clamp(1.5rem, 5vw, 3.5rem)
     means "never closer than 1.5rem to the edge, never further than 3.5rem,
     scaling with 5% of the viewport width in between". */
  .hero-ui {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; color: #d8dfe5;
  }
  .game-logo {
    position: absolute; left: clamp(1.5rem, 5vw, 3.5rem); top: 50%;
    width: clamp(9rem, 31vw, 32rem); height: auto;
    transform: translateY(-50%);
    filter: drop-shadow(0 5px 15px rgb(0 0 0 / .5));
  }
  /* Sits directly under the logo (same left edge) instead of the opposite
     corner. Change `font-family` here to switch the typeface, and
     `text-align` to change how the lines of text line up (currently
     right-aligned, per your request). */
  .game-copy {
    position: absolute; right: clamp(1.5rem, 5vw, 3.5rem); top: 50%;
    transform: translateY(-50%);
    margin: 0; width: min(38vw, 34rem); max-width: calc(100% - 2 * clamp(1.5rem, 5vw, 3.5rem));
    overflow-wrap: anywhere; text-wrap: pretty;
    font-family: var(--font-body); font-size: clamp(.85rem, 1.55vw, 1.875rem); line-height: 1.35; text-align: right;
    text-shadow: 0 5px 8px #000, 0 0 20px rgb(0 0 0 / .5);
  }
  /* Triggers on EITHER condition: a narrow window (max-width) OR a tall/
     portrait-ish aspect ratio (max-aspect-ratio, width:height ≤ 3:4) — so
     the stacked mobile layout also kicks in on tall narrow windows/tablets
     that happen to be wider than 640px but are still clearly "portrait". */
  @media (max-width: 640px), (max-aspect-ratio: 3 / 4) {
    .hero-ui {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      height: 100%; gap: clamp(1rem, 4vh, 1.75rem);
      padding: 0 clamp(1.25rem, 8vw, 2.5rem);
    }
    .game-logo {
      position: static; width: min(78vw, 26rem); transform: none;
    }
    .game-copy {
      position: static; width: min(90vw, 30rem); max-width: none; transform: none;
      text-align: center;
      font-size: clamp(1rem, 4vw, 1.375rem);
    }
  }
  @media (prefers-reduced-motion: reduce) { .table-plane-inner, .mist-video-wrapper, .hero-ui, .table-component { transition: none !important; } }

  /* Studio logo / menu button / site nav styling now lives in
     SiteChrome.astro (see that file's <style>) — removed the duplicate
     that used to live here. See the comment above `</Layout>` for why. */

  /* SCENE 2 ------------------------------------------------------------ */
  .scene2 {
    /* Stacked exactly on top of .hero inside .pin-stage. The box (frame 0
       of the intro sequence) is visible from page load — since the hero
       background no longer has its own baked-in box, this canvas IS the
       box, sitting in place the whole time. Scrolling doesn't fade this
       layer in; it fades the hero's OTHER decorative pieces OUT from
       underneath/around it instead, and plays the box through its intro
       motion. pointer-events:none is a hard safety net: this layer can
       NEVER intercept clicks/scroll until JS explicitly adds
       .is-interactive to it (during phase 2, once rotation is live). */
    position: absolute; inset: 0; z-index: 10;
    pointer-events: none;
    overflow: hidden;
  }
  .scene2.is-interactive { pointer-events: auto; }

  /* Fog wash — sits above both the hero and Scene 2, fully transparent by
     default. Its opacity is driven from the script (a bell curve across
     the crossfade). Oversized (-15% inset) and blurred so it can drift
     without ever showing a hard edge. Two layers drifting at slightly
     different speeds/directions read as soft, alive fog rather than a
     static image. */
  .transition-mist {
    position: absolute; inset: -15%;
    z-index: 15;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    filter: blur(28px);
    will-change: opacity;
  }
  .transition-mist__layer {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 55% 38% at 22% 58%, rgb(233 238 234 / .6), transparent 70%),
      radial-gradient(ellipse 48% 34% at 78% 42%, rgb(214 224 217 / .5), transparent 70%),
      radial-gradient(ellipse 65% 42% at 50% 78%, rgb(223 231 224 / .45), transparent 70%);
  }
  .transition-mist__layer--a { animation: mist-drift-a 14s ease-in-out infinite; }
  .transition-mist__layer--b { animation: mist-drift-b 19s ease-in-out infinite reverse; opacity: .7; }
  @keyframes mist-drift-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(3%, -2%) scale(1.06); }
  }
  @keyframes mist-drift-b {
    0%, 100% { transform: translate(0, 0) scale(1.04); }
    50% { transform: translate(-4%, 2%) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .transition-mist__layer--a, .transition-mist__layer--b { animation: none; }
  }

  /* Identical formula to .artboard in the hero — same cover-fit box, same
     scale, same crop behavior — so the box reads as the same object in
     the same place, not a smaller/differently-scaled re-render.
     If it's still not pixel-perfect against the hero, nudge it here —
     these three variables are the ONLY place you should need to touch:
       --fix-scale: multiplies the whole box size (1 = no change,
                    1.01 = 1% bigger, 0.99 = 1% smaller)
       --fix-x / --fix-y: nudges position in pixels (positive = right/down) */
  .scene2-artboard {
    --fix-scale: 1;
    --fix-x: 0px;
    --fix-y: 0px;
    position: absolute; inset: 50% auto auto 50%;
    width: max(100%, calc(100dvh * 16 / 9));
    height: max(100%, calc(100dvw * 9 / 16));
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%) translate(var(--fix-x), var(--fix-y)) scale(var(--fix-scale));
    z-index: 1;
  }
  .scene2-canvas {
    display: block; width: 100%; height: 100%;
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / .55));
  }
  /* Each icon sweeps horizontally past this anchor point (roughly in
     front of the box) — .icon-orbit is a zero-size point that the script
     moves with x (left-to-right sweep); .info-icon is just statically
     centered on its own anchor via the translate below, so GSAP's x on
     the *parent* never conflicts with this transform. */
  .scene2-info {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
  }
  /* Where the icons appear — the empty space to the LEFT of the box, not
     across/over it. Nudge --anchor-left/--anchor-top to line this up with
     your art (a value further right moves it closer to the box). */
  .icon-orbit {
    --anchor-top: 38%;
    --anchor-left: 21%;
    position: absolute; top: var(--anchor-top); left: var(--anchor-left);
  }
  .info-icon {
    position: absolute; top: 0; left: 0; transform: translate(-50%, -50%);
    width: clamp(6.75rem, 13.5vw, 11.25rem); height: auto;
    opacity: 0; /* the script drives opacity/scale as it enters/exits */
  }
  @media (max-width: 640px), (max-aspect-ratio: 3 / 4) {
    .info-icon { width: clamp(4.875rem, 22.5vw, 7.5rem); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // Dev-mode safety net: if Vite/Astro hot-reloads this script (e.g. after
  // saving a file), old ScrollTrigger instances — and the pin-spacer DOM
  // they inserted — can be left behind, which corrupts pinning and freezes
  // scroll until a full page reload. Clearing any previous instances first
  // makes re-running this script idempotent.
  ScrollTrigger.getAll().forEach((instance) => instance.kill());

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const motionAllowed = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Bug (reported on mobile Safari): tapping the box (or any table piece)
  // made it visibly glide, even though nothing but frame 0 should ever move
  // there. Cause: this whole section is a MOUSE-hover parallax (pointermove
  // → GSAP quickTo), but Safari on iOS fires a synthetic 'pointermove' as
  // part of handling a tap — Chrome on Android generally doesn't. Gating on
  // `hover: hover` (true only when the primary input can actually hover,
  // i.e. a real mouse/trackpad) excludes touch-primary devices, so a tap
  // can't trigger this at all — matches motionAllowed's pattern of a
  // one-time capability check on load, not a live per-event check.
  const pointerAllowed = matchMedia('(hover: hover) and (pointer: fine)').matches;
  // Hoisted so Scene 2's script (further down) can neutralize the hero's
  // mouse parallax once scrolling begins — otherwise the hero box can be
  // sitting offset from center (wherever the mouse was) while Scene 2's
  // frame 1 always renders at dead-center, causing a visible mismatch.
  let plane: HTMLElement | null = null;
  let mist: HTMLElement | null = null;
  let heroParallaxActive = true;

  if (hero && motionAllowed && pointerAllowed) {
    plane = hero.querySelector<HTMLElement>('.table-plane-inner')!;
    mist = hero.querySelector<HTMLElement>('.mist-video-wrapper')!;
    // The box (Scene 2's canvas) sits on the same table plane, so it needs
    // the exact same parallax movement — otherwise it visually "floats"
    // detached from the table while everything else shifts with the mouse.
    const box = document.querySelector<HTMLElement>('.scene2-artboard');
    const quickMove = (element: HTMLElement) => ({
      x: gsap.quickTo(element, 'x', { duration: .65, ease: 'power3.out' }),
      y: gsap.quickTo(element, 'y', { duration: .65, ease: 'power3.out' }),
    });
    const planeMove = quickMove(plane);
    const mistMove = quickMove(mist);
    const boxMove = box ? quickMove(box) : null;

    hero.addEventListener('pointermove', (event) => {
      if (!heroParallaxActive) return;
      const x = event.clientX - innerWidth / 1.1;
      const y = event.clientY - innerHeight / 1.1;
      // Background and all tabletop components deliberately move as one plane.
      planeMove.x(-x * .01); planeMove.y(-y * .0);
      mistMove.x(-x * .08); mistMove.y(-y * 1);
      boxMove?.x(-x * .01); boxMove?.y(-y * .0); // same multiplier as the plane, so it stays locked to the table
    });

    hero.querySelectorAll<HTMLElement>('.table-component').forEach((component) => {
      const glideX = gsap.quickTo(component, 'x', { duration: .5, ease: 'power2.out' });
      const glideY = gsap.quickTo(component, 'y', { duration: .5, ease: 'power2.out' });
      const turn = gsap.quickTo(component, 'rotation', { duration: .75, ease: 'power2.out' });

      component.addEventListener('pointermove', (event) => {
        const bounds = component.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - .5;
        const y = (event.clientY - bounds.top) / bounds.height - .5;
        // ±0.5 pointer offset maps to a maximum ±18px glide; values persist after exit.
        glideX(x * 75); glideY(y * 75); turn(x * 25.9);
      });
    });
  }

  // Studio logo doubles as Home — smooth-scroll to the hero instead of an
  // instant jump (also plays nicer with ScrollTrigger's pinned sections
  // below than a bare anchor jump would).
  document.querySelector<HTMLAnchorElement>('[data-scroll-home]')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.getElementById('hero')?.scrollIntoView({ behavior: 'smooth' });
  });

  // Menu toggle + Contact Us reveal: now handled once by SiteChrome.astro's
  // own <script>, since that's the only place the markup lives. A second
  // copy here used to bind to whichever `[data-menu-toggle]` element
  // querySelector found first, which wasn't necessarily the one on screen —
  // see the comment above `</Layout>` for the full story.

  // SCENE 2 --------------------------------------------------------------
  // Two frame sequences, drawn to a <canvas> so scroll/mouse position can
  // pick an exact frame with no video-buffering lag:
  //   intro-####.webp  (60 frames) — scrubbed by SCROLL as the person
  //     enters the section (the box turns from its hero-corner angle to
  //     floating, front-facing, center).
  //   rotate-####.webp (85 frames) — scrubbed by MOUSE X once the intro
  //     has finished, simulating the person "turning" the box by hand.
  // Change INTRO_FRAMES / ROTATE_FRAMES below if your actual export has a
  // different frame count than what I counted from your preview videos.
  const INTRO_FRAMES = 60;
  const ROTATE_FRAMES = 85;
  const pad4 = (n: number) => String(n).padStart(4, '0');
  // intro files are numbered intro-0001.webp ... intro-0060.webp (1-based)
  const introSrc = (loopIndex: number) => `/scene2/box/intro-${pad4(loopIndex + 1)}.webp`;
  // rotate files are numbered rotate-0000.webp ... rotate-0084.webp (0-based)
  const rotateSrc = (loopIndex: number) => `/scene2/box/rotate-${pad4(loopIndex)}.webp`;

  function preloadSequence(count: number, srcFor: (loopIndex: number) => string) {
    const images: HTMLImageElement[] = new Array(count);
    const loaded = Array.from({ length: count }, (_, i) => {
      const img = new Image();
      img.decoding = 'async';
      img.src = srcFor(i);
      images[i] = img;
      return new Promise<void>((resolve) => {
        img.onload = () => resolve();
        img.onerror = () => resolve(); // don't block the whole sequence on one missing frame
      });
    });
    return { images, ready: Promise.all(loaded) };
  }

  const stage = document.querySelector<HTMLElement>('[data-pin-stage]');
  const scene2 = document.querySelector<HTMLElement>('[data-scene2]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-scene2-canvas]');
  const ctx = canvas?.getContext('2d') ?? null;

  function drawFrame(img: HTMLImageElement | undefined) {
    if (!ctx || !canvas || !img || !img.complete || !img.naturalWidth) return;
    if (canvas.width !== img.naturalWidth) canvas.width = img.naturalWidth;
    if (canvas.height !== img.naturalHeight) canvas.height = img.naturalHeight;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0);
  }

  if (!stage || !scene2 || !canvas || !ctx) {
    console.warn('[Scene 2] Skipped: missing element(s)', { stage, scene2, canvas, ctx });
  } else {
    // FIX (2026-08-22): this used to call preloadSequence() for BOTH full
    // sequences (60 intro + 85 rotate = 145 webp frames, ~244MB total)
    // right here, completely unguarded by SCENE2_ENABLED below — so every
    // visitor to the homepage (including on the live site) downloaded all
    // 244MB just to paint one static frame. Confirmed via the Network tab.
    // Now only the ONE frame actually needed for that static image loads
    // eagerly; the other 144 frames only load once SCENE2_ENABLED is
    // switched back on (moved into that block below). Doesn't touch the
    // hero at all — same visual result (box static on frame 0), ~150x less
    // data.
    const firstFrame = new Image();
    firstFrame.decoding = 'async';
    firstFrame.onload = () => drawFrame(firstFrame);
    firstFrame.src = introSrc(0);

    // Shelved for now so the chatbot work can be deployed without also
    // shipping the still-in-progress intro/rotate behavior. The hero
    // shows exactly as it does today — box static on frame 0, nothing
    // fades, no scroll pin, no mouse rotation — and every line below
    // stays completely intact, just inert. Flip this back to `true`
    // whenever we're ready to pick Scene 2 back up; nothing else needs
    // to change.
    const SCENE2_ENABLED = false;
    if (SCENE2_ENABLED) {
    // Both full frame sequences (~244MB) only load once Scene 2 is
    // actually switched on — see the firstFrame comment above.
    const intro = preloadSequence(INTRO_FRAMES, introSrc);
    const rotate = preloadSequence(ROTATE_FRAMES, rotateSrc);
    intro.ready.then(() => drawFrame(intro.images[0]));

    // Only the decorative pieces scattered on the table (+ the hero's own
    // ambient mist video, if present) fade out — NOT the base table
    // surface, which stays visible the whole time as the ground the box
    // sits on.
    const heroBg = gsap.utils.toArray<HTMLElement>('.table-components, .mist-video-wrapper');
    const heroText = document.querySelector<HTMLElement>('.hero-ui');
    const transitionMist = document.querySelector<HTMLElement>('[data-transition-mist]');
    gsap.set(transitionMist, { opacity: 0 }); // OFF for now — revisit once it's meant to run across every scene

    if (!motionAllowed) {
      // Reduced motion: skip straight to the end state — Scene 2 fully
      // visible with the box resolved and the info icons already in place.
      gsap.set(heroBg, { opacity: 0 });
      gsap.set(heroText, { opacity: 0 });
      scene2.classList.add('is-interactive');
      gsap.set('.info-icon', { opacity: 1, y: 0 });
      intro.ready.then(() => drawFrame(intro.images[INTRO_FRAMES - 1]));
    } else {
      // Total pinned scroll distance for all of Scene 2 (intro + rotate +
      // icons). Tune to taste — icon pacing no longer depends on this
      // being any particular size (see ICON_STEP_PX below).
      const PIN_DISTANCE = '+=1000%';

      let targetFrame = Math.floor((ROTATE_FRAMES - 1) / 2);
      let currentFrame = targetFrame;
      let rotateActive = false;

      // The box itself is ALREADY visible (sitting on frame 0) from page
      // load. Scrolling doesn't crossfade a whole new layer in anymore —
      // it just fades the hero's decorative pieces out and plays the box
      // through its intro motion. Still one authored, fixed-duration
      // timeline (not scrubbed 1:1 to scroll) — scroll only triggers it.
      const introState = { fade: 0, frame: 0 };
      const introTL = gsap.timeline({ paused: true })
        .to(introState, {
          fade: 1, duration: 0.9, ease: 'power2.inOut',
          onUpdate: () => {
            gsap.set(heroBg, { opacity: 1 - introState.fade });
            gsap.set(heroText, { opacity: 1 - gsap.utils.clamp(0, 1, (introState.fade - 0.15) / 0.85) });
          },
        })
        .to(introState, {
          frame: INTRO_FRAMES - 1, duration: 1.1, ease: 'power1.inOut',
          onUpdate: () => drawFrame(intro.images[Math.round(introState.frame)]),
        }, '-=0.15');

      let introEntered = false;

      scene2.addEventListener('pointermove', (event) => {
        const pct = gsap.utils.clamp(0, 1, event.clientX / window.innerWidth);
        targetFrame = Math.round(pct * (ROTATE_FRAMES - 1));
      });

      gsap.ticker.add(() => {
        if (!rotateActive) return;
        currentFrame += (targetFrame - currentFrame) * 0.08; // smoothed follow, not a hard snap
        drawFrame(rotate.images[Math.round(currentFrame)]);
      });

      const icons = gsap.utils.toArray<HTMLElement>('.icon-orbit');
      const iconImgs = gsap.utils.toArray<HTMLElement>('.info-icon');
      // Small travel, and always the SAME side (further left, off-screen)
      // — icons enter from the left, settle in the empty space beside the
      // box.
      const iconTravel = () => Math.min(window.innerWidth * 0.2, 240);
      // Exit continues the same left-to-right motion (rather than
      // retreating back offscreen-left) and dissolves partway toward the
      // box, instead of reversing direction.
      const iconExitDrift = () => iconTravel() * 0.55;

      // Each icon is TWO independent triggers, not one timed sequence:
      // scrolling into its zone plays the entrance, and it then just sits
      // there — however long the user takes — until scrolling into the
      // NEXT zone plays its exit. So `steps` alternates
      // [enter0, exit0, enter1, exit1, enter2, exit2] — 6 total triggers
      // across phase 2's scroll range, each a fixed-duration, eased
      // timeline (scroll only triggers it, doesn't scrub it), matching
      // the "scroll triggers a polished animation" feel of oryzo.ai.
      const steps: gsap.core.Timeline[] = [];
      icons.forEach((orbit, i) => {
        gsap.set(orbit, { x: -iconTravel(), zIndex: 20 });
        gsap.set(iconImgs[i], { opacity: 0 });
        steps.push(
          gsap.timeline({ paused: true })
            .fromTo(orbit, { x: () => -iconTravel() }, { x: 0, duration: 0.85, ease: 'power2.out' })
            .fromTo(iconImgs[i], { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.55, ease: 'sine.out' }, '<'),
        );
        steps.push(
          gsap.timeline({ paused: true })
            .to(orbit, { x: () => iconExitDrift(), duration: 0.9, ease: 'power1.in' })
            .to(iconImgs[i], { opacity: 0, scale: 0.9, duration: 0.7, ease: 'sine.in' }, '<'),
        );
      });
      let activeIconStep = -1;
      let phase2EnteredAt: number | null = null;
      let phase2StartScrollY: number | null = null;
      let lastIconStepAt = 0;
      const ICON_START_DELAY = 500; // ms — real time to wait after the intro fully settles before the first icon is allowed to trigger
      const ICON_STEP_PX = 180; // scroll px it takes to be "eligible" to trigger the next icon step — independent of the (large) PIN_DISTANCE
      const MIN_ICON_STEP_INTERVAL = 900; // ms — even with a big/fast scroll, steps can't advance faster than this, so every icon gets seen

      // Advances (or reverses) exactly ONE step toward `desiredStep`, never
      // more — a big or fast scroll just means later calls keep advancing
      // one at a time (rate-limited below) instead of jumping straight to
      // the target and skipping everything in between unseen.
      function setIconStep(desiredStep: number) {
        desiredStep = Math.min(steps.length - 1, Math.max(0, desiredStep));
        if (desiredStep === activeIconStep) return;
        const now = performance.now();
        if (now - lastIconStepAt < MIN_ICON_STEP_INTERVAL) return; // too soon — a later tick will pick this back up
        const dir = desiredStep > activeIconStep ? 1 : -1;
        const next = activeIconStep + dir;
        if (dir > 0) steps[next].play();
        else steps[next].reverse();
        activeIconStep = next;
        lastIconStepAt = now;
      }

      function resetIconSteps() {
        phase2EnteredAt = null;
        phase2StartScrollY = null;
        lastIconStepAt = 0;
        if (activeIconStep === -1) return;
        steps.forEach((tl) => tl.progress(0).pause());
        activeIconStep = -1;
      }

      // Both the intro and the icons are trigger-based, fixed-duration
      // timelines now (not continuously scrubbed to scroll position), so
      // we apply the raw scroll progress directly — no extra smoothing
      // layer needed, since that was just adding lag on top of triggers
      // that are already eased internally.
      let introDone = false;
      introTL.eventCallback('onComplete', () => { introDone = true; });
      introTL.eventCallback('onReverseComplete', () => { introDone = false; });

      function applyProgress(p: number) {
        // Only touch the hero's mouse parallax once we're ACTUALLY
        // transitioning away from it — at rest at the very top (p=0)
        // it must keep working normally.
        heroParallaxActive = p <= 0.001;
        if (!heroParallaxActive) {
          if (plane) gsap.set(plane, { x: 0, y: 0 });
          if (mist) gsap.set(mist, { x: 0, y: 0 });
        }

        // The intro timeline is triggered once by crossing this
        // threshold — not scrubbed — and reversed the same way once
        // scrolled all the way back to the hero.
        const shouldBeEntered = p > 0.001;
        if (shouldBeEntered !== introEntered) {
          introEntered = shouldBeEntered;
          if (introEntered) introTL.play();
          else introTL.reverse();
        }

        if (!introDone) {
          // Still mid-intro (or back at the hero) — icons wait, rotation
          // is off. Gated on the timeline's OWN completion, not on scroll
          // distance, so the ~2.7s intro always plays out in full instead
          // of being cut short by a scroll threshold racing ahead of it.
          rotateActive = false;
          scene2.classList.remove('is-interactive');
          resetIconSteps(); // all parked, waiting for phase 2
        } else {
          // Phase 2: hero fully gone, Scene 2 fully in. Mouse drives the
          // rotate sequence continuously (via the ticker above), totally
          // independent of scroll.
          rotateActive = true;
          scene2.classList.add('is-interactive'); // only NOW can it receive pointermove/clicks

          if (phase2EnteredAt === null) phase2EnteredAt = performance.now();
          if (phase2StartScrollY === null) phase2StartScrollY = window.scrollY;

          // Give the intro a beat to fully settle before the first icon
          // is allowed to start. Purely time-based, so it's the same
          // pause regardless of how fast the pin is scrolled.
          if (performance.now() - phase2EnteredAt >= ICON_START_DELAY) {
            // Real scroll PIXELS since entering phase 2, divided into
            // small fixed-size steps — decoupled from PIN_DISTANCE (which
            // can be huge) so a normal scroll gesture or two is enough to
            // move to the next icon, not a large fraction of the pin.
            const pxIntoPhase2 = Math.max(0, window.scrollY - phase2StartScrollY);
            const step = Math.min(steps.length - 1, Math.floor(pxIntoPhase2 / ICON_STEP_PX));
            setIconStep(step);
          }
        }
      }

      ScrollTrigger.create({
        trigger: stage,
        start: 'top top',
        end: PIN_DISTANCE,
        pin: true,
        scrub: true,
        markers: true, // TEMPORARY again — testing whether pin still works
        onUpdate(self) {
          applyProgress(self.progress);
        },
      });
    }
    } // end SCENE2_ENABLED
  }
</script>